<odoo>
    <template id="track_bom_line_template">
        <div>
            <strong>The component details have been updated.</strong>
            <ul>
                <t t-foreach="lines" t-as="line">
                    <li><t t-out="line.product_id.display_name" />:</li>
                    Product Quantity: <t t-out="line.product_qty" /><t
                    t-if='line.product_qty != product_qty'
                > -&gt; <t t-out="float(product_qty)" /></t><br />
                    Product Unit of Measure: <t
                    t-out="line.uom_id.display_name"
                /><t t-if='line.uom_id != uom_id'> -&gt; <t
                    t-out="uom_id.display_name"
                /></t><br />
                    <t
                    t-if='line.operation_id != operation_id'
                >Consumed in Operation: <t
                    t-out="line.operation_id.display_name or ''"
                /> -&gt; <t t-out="operation_id.display_name or ''" /><br /></t>
                </t>
            </ul>
        </div>
    </template>
    <template id="track_bom_template">
        <div>
            <strong>The components have changed.</strong>
            <ul>
                <t t-foreach="lines" t-as="line">
                    <li><t t-out="line.product_id.display_name" />: <t
                    t-out="mode"
                /> component<br /></li>
                    Product Quantity: <t t-out="line.product_qty" /><br />
                    Product Unit of Measure: <t
                    t-out="line.uom_id.display_name"
                /><br />
                </t>
            </ul>
        </div>
    </template>
    <template id="track_bom_template_2">
        <div>
            <strong>The components have changed.</strong>
            <ul>
                <t t-foreach="lines" t-as="line">
                    <li><t t-out="line.product_id.display_name" />:
                Removed component<br /></li>
                    <li><t t-out="product_id.display_name" />:
                New component<br /></li>
                </t>
            </ul>
        </div>
    </template>
</odoo>
