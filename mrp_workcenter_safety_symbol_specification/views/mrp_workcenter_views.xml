<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_workcenter_safety_specification_list" model="ir.ui.view">
        <field name="name">mrp.workcenter.safety.specification.list</field>
        <field name="model">mrp.workcenter.safety.specification</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Safety Specifications">
                <field name="sequence" widget="handle" />
                <field
                    name="symbol_image"
                    string="Icon"
                    widget="image"
                    options="{'size': [30, 30]}"
                />
                <field
                    name="iso_symbol_id"
                    string="Symbol"
                    options="{'no_create': True, 'no_open': True}"
                    required="1"
                />
                <field name="symbol_code" string="Code" />
                <field name="specification_notes" />
            </list>
        </field>
    </record>

    <record id="view_mrp_workcenter_safety_specification_form" model="ir.ui.view">
        <field name="name">mrp.workcenter.safety.specification.form</field>
        <field name="model">mrp.workcenter.safety.specification</field>
        <field name="arch" type="xml">
            <form string="Safety Specification">
                <sheet>
                    <group>
                        <group>
                            <field name="workcenter_id" invisible="1" />
                            <field
                                name="iso_symbol_id"
                                required="1"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="sequence" invisible="1" />
                        </group>
                        <group>
                            <field
                                name="symbol_image"
                                widget="image"
                                options="{'size': [90, 90]}"
                                nolabel="1"
                            />
                        </group>
                    </group>
                    <group string="Specification / Notes">
                        <field
                            name="specification_notes"
                            placeholder="Enter specific details here..."
                            nolabel="1"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record
        id="mrp_workcenter_view_form_inherit_safety_specification"
        model="ir.ui.view"
    >
        <field name="name">mrp.workcenter.form.inherit.safety.specification</field>
        <field name="model">mrp.workcenter</field>
        <field
            name="inherit_id"
            ref="mrp_workcenter_safety_symbol.mrp_workcenter_view_form_inherit_safety"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='safety_symbols']/field[@name='safety_symbol_ids']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
                expr="//page[@name='safety_symbols']/field[@name='safety_symbol_ids']/following-sibling::group[1]"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath
                expr="//page[@name='safety_symbols']/field[@name='safety_symbol_ids']/following-sibling::group[1]"
                position="after"
            >
                <group>
                    <p class="oe_grey">
                         Safety symbols associated with this work center. Add or click entries to specify details (e.g., PPE type, checks).
                     </p>
                </group>
            </xpath>

            <xpath expr="//page[@name='safety_symbols']" position="inside">
                <field
                    name="safety_specification_ids"
                    nolabel="1"
                    mode="kanban"
                    options="{'no_create_edit': False}"
                >
                    <kanban create="true" quick_create="false" limit="20">
                        <field name="id" />
                        <field name="iso_symbol_id" />
                        <field name="symbol_image" />
                        <field name="symbol_code" />
                        <field name="specification_notes" />
                        <templates>
                            <t t-name="kanban-card">
                                <div class="oe_kanban_card">
                                    <div
                                        class="oe_kanban_global_click"
                                        style="width: 130px; height: 190px; /* Fixed size */
                                             padding: 5px; display: flex; flex-direction: column;
                                             align-items: center; justify-content: flex-start; /* Align top */
                                             border: 1px solid #dee2e6; margin: 2px; border-radius: 3px;"
                                    >
                                        <div class="mb-1">
                                            <field
                                                name="symbol_image"
                                                widget="image"
                                                options="{'size': [80, 80]}"
                                            />
                                        </div>

                                        <div
                                            style="font-size: 0.85em; line-height: 1.2; text-align: center; width: 100%; overflow: hidden;"
                                        >
                                            <strong>
                                                <field name="symbol_code" />
                                            </strong>
                                            <div class="text-muted mb-1">
                                                <field
                                                    name="iso_symbol_id"
                                                    options="{'no_open': True}"
                                                />
                                            </div>
                                            <div
                                                class="text-muted"
                                                t-att-title="record.specification_notes.raw_value"
                                                style="max-height: 3.6em; /* Approx 3 lines */
                                                     overflow: hidden; text-overflow: ellipsis;
                                                     display: -webkit-box; -webkit-line-clamp: 3;
                                                     -webkit-box-orient: vertical; font-style: italic;"
                                            >
                                                <field name="specification_notes" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </templates>
                    </kanban>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
