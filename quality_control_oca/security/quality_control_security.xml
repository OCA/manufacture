<odoo>
    <record id="module_category_quality_control" model="ir.module.category">
        <field name="name">Quality control</field>
    </record>
    <record id="quality_control_privilege" model="res.groups.privilege">
        <field name="name">Quality Control</field>
        <field name="category_id" ref="module_category_quality_control" />
        <field name="sequence" eval="10" />
    </record>
    <record id="group_quality_control_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="quality_control_privilege" />
    </record>
    <record id="group_quality_control_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="quality_control_privilege" />
        <field name="implied_ids" eval="[(4, ref('group_quality_control_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
