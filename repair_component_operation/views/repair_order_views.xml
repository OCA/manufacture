<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form" model="ir.ui.view">
            <field name="name">repair.order.form</field>
            <field name="model">repair.order</field>
            <field name="inherit_id" ref="repair.view_repair_order_form" />
            <field name="arch" type="xml">
                <button name="action_repair_cancel" position="after">
                    <button
                    name="button_operate_components"
                    type="object"
                    string="Operate Components"
                    attrs="{'invisible': [('state', 'in', ('cancel', 'draft', 'done'))]}"
                />
                </button>
                <div name="button_box" position="inside">
                    <button
                    name="button_open_scrap"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-trash"
                    attrs="{'invisible': [('scrap_count', '=', 0)]}"
                    help="Scraps associated with this repair order"
                >
                    <field name="scrap_count" widget="statinfo" string="Scraps" />
                </button>
                </div>
            </field>
    </record>
</odoo>
