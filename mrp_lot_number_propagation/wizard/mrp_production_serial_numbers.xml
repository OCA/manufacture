<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mrp_production_serials_form" model="ir.ui.view">
        <field name="name">view_mrp_production_serials_form</field>
        <field name="model">mrp.production.serials</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_serials_form" />
        <field name="arch" type="xml">
            <field name="serial_numbers" position="attributes">
                <attribute name="readonly">is_lot_number_propagated</attribute>
                <attribute name="force_save">True</attribute>
            </field>
            <field name="lot_name" position="attributes">
                <attribute name="invisible">is_lot_number_propagated</attribute>
            </field>
            <field name="lot_quantity" position="attributes">
                <attribute name="invisible">is_lot_number_propagated</attribute>
            </field>
            <button name="action_generate_serial_numbers" position="attributes">
                <attribute name="invisible">is_lot_number_propagated</attribute>
            </button>
            <field name="serial_numbers" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not lot_number_propagation_alert_msg"
                >
                    <field name="lot_number_propagation_alert_msg" />
                </div>
            </field>
        </field>
    </record>
</odoo>
