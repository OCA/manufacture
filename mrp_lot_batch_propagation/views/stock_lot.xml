<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_lot_form_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="batch_bom_id" readonly="1" invisible="not batch_bom_id" />
                <field name="batch_production_id" readonly="1" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
