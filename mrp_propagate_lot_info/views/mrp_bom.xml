<odoo>
    <record id="mrp_bom_form_view" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.propagate.lot.info</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list" position="inside">
                <field name="propagate_lot_profile_id" optional="hide" />
                <field
                    name="propagate_lot_field_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </xpath>
            <xpath expr="//field[@name='byproduct_ids']/list" position="inside">
                <field name="propagate_lot_info" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
