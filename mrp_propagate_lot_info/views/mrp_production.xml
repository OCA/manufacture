<odoo>
    <record id="mrp_production_form_view" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.propagate.lot.info</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miscellaneous']/group/group" position="inside">
                <field name="propagate_lot_profile_id" />
                <field
                    name="propagate_lot_bom_line_id"
                    invisible="not propagate_lot_bom_line_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
