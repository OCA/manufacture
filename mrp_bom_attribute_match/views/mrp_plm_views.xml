<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add component_template_id field to mrp.eco.bom.change model form view -->
    <record id="mrp_eco_bom_change_view_form_inherit" model="ir.ui.view">
        <field name="name">mrp.eco.bom.change.view.form.inherit</field>
        <field name="model">mrp.eco.bom.change</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_bom_change_view_form"/>
        <field name="arch" type="xml">
            <!-- Add component_template_id field after product_id field -->
            <field name="product_id" position="after">
                <field name="component_template_id"/>
                <field name="product_backup_id" invisible="1"/>
                <field name="match_on_attribute_ids" widget="many2many_tags" string="Match on Attributes"/>
            </field>
            
            <!-- Make product_id readonly when component_template_id is set -->
            <field name="product_id" position="attributes">
                <attribute name="readonly">component_template_id != False</attribute>
                <attribute name="force_save">"1"</attribute>
            </field>
        </field>
    </record>
    
    <!-- Add component_template_id field to BOM Changes tree view -->
    <record id="mrp_eco_view_form_inherit" model="ir.ui.view">
        <field name="name">mrp.eco.view.form.inherit</field>
        <field name="model">mrp.eco</field>
        <field name="inherit_id" ref="mrp_plm.mrp_eco_view_form"/>
        <field name="arch" type="xml">
            <!-- Add component_template_id field to BOM Changes tree view -->
            <xpath expr="//field[@name='bom_change_ids']/tree/field[@name='product_id']" position="after">
                <field name="component_template_id" optional="show"/>
            </xpath>
            
            <!-- Make product_id readonly when component_template_id is set in BOM Changes tree view -->
            <xpath expr="//field[@name='bom_change_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="readonly">component_template_id != False</attribute>
                <attribute name="force_save">"1"</attribute>
            </xpath>
            
            <!-- Add component_template_id field to BOM Rebase tree view -->
            <xpath expr="//field[@name='bom_rebase_ids']/tree/field[@name='product_id']" position="after">
                <field name="component_template_id" optional="show"/>
            </xpath>
            
            <!-- Make product_id readonly when component_template_id is set in BOM Rebase tree view -->
            <xpath expr="//field[@name='bom_rebase_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="readonly">component_template_id != False</attribute>
                <attribute name="force_save">"1"</attribute>
            </xpath>
            
            <!-- Add component_template_id field to Previous ECO BOM Changes tree view -->
            <xpath expr="//field[@name='previous_change_ids']/tree/field[@name='product_id']" position="after">
                <field name="component_template_id" optional="show"/>
            </xpath>
            
            <!-- Make product_id readonly when component_template_id is set in Previous ECO BOM Changes tree view -->
            <xpath expr="//field[@name='previous_change_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="readonly">component_template_id != False</attribute>
                <attribute name="force_save">"1"</attribute>
            </xpath>
        </field>
    </record>
</odoo>