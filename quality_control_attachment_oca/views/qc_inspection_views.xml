<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="qc_inspection_form_view">
        <field
            name="name"
        >qc.inspection.form.inherit.quality_control_attachment_oca</field>
        <field name="model">qc.inspection</field>
        <field name="inherit_id" ref="quality_control_oca.qc_inspection_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="Attachments"
                    attrs="{'invisible': [('test', '=', False)]}"
                >
                    <field name="attachment_ids" nolabel="1">
                        <tree editable="top">
                            <field name="name" />
                            <field
                                name="datas"
                                filename="name"
                                widget="binary"
                                string="File"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
