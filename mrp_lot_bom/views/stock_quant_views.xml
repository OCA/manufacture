<odoo>
    <record id="quant_search_view" model="ir.ui.view">
        <field name="name">stock.quant.search - mrp_lot_bom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="bom_id" groups="stock.group_production_lot" />
            </field>
            <filter name="Lot_Serial_number" position="after">
                <filter
                    name="group_by_bom"
                    string="Bill of Materials"
                    domain="[]"
                    context="{'group_by': 'bom_id'}"
                    groups="stock.group_production_lot"
                />
            </filter>
        </field>
    </record>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.editable - mrp_lot_bom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field
                    name="bom_id"
                    groups="stock.group_production_lot"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable - mrp_lot_bom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field
                    name="bom_id"
                    groups="stock.group_production_lot"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="view_stock_quant_tree_simple" model="ir.ui.view">
        <field name="name">stock.quant.tree - mrp_lot_bom</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field
                    name="bom_id"
                    groups="stock.group_production_lot"
                    optional="show"
                />
            </field>
        </field>
    </record>
</odoo>
