<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="qc_inspection_form_view">
        <field name="name">qc.inspection.form.inherit.quality_control_attachment_oca
        </field>
        <field name="model">qc.inspection</field>
        <field name="inherit_id" ref="quality_control_oca.qc_inspection_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <field name="enable_image" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='inspection_lines']/tree//field[@name='success']"
                position="after"
            >
                <field
                    name="image_1920"
                    widget='image'
                    class="oe_avatar"
                    attrs="{'required': [('success', '=', False)]}"
                    options="{'zoom': true, 'preview_image':'image_128'}"
                />
            </xpath>
        </field>
    </record>

</odoo>
