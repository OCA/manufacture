<?xml version="1.0" ?>
<odoo>
    <record id="product_template_form_view_allergens" model="ir.ui.view">
        <field name="name">product.template.view.form.allergens.bom</field>
        <field name="model">product.template</field>
        <field name="priority">4</field>
        <field
            name="inherit_id"
            ref="product_allergen.product_template_form_view_allergens"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allergen_ids']" position="after">
                <t groups="mrp.group_mrp_manager">
                    <button
                        name="button_bom_allergens"
                        string="Compute Allergens from BoM"
                        type="object"
                        invisible="bom_count == 0"
                        help="Compute the allergens of the product using products and operations of related bill of materials, for manufactured products only."
                        class="oe_link pt-0"
                        colspan="2"
                    />
                </t>
            </xpath>
        </field>
    </record>
    <record id="product_variant_form_view_allergens" model="ir.ui.view">
        <field name="name">product.product.view.form.allergens.bom</field>
        <field name="model">product.product</field>
        <field name="priority">4</field>
        <field
            name="inherit_id"
            ref="product_allergen.product_variant_form_view_allergens"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allergen_ids']" position="after">
                <t groups="mrp.group_mrp_manager">
                    <button
                        name="button_bom_allergens"
                        string="Compute Allergens from BoM"
                        type="object"
                        invisible="bom_count == 0"
                        help="Compute the allergens of the product using products and operations of related bill of materials, for manufactured products only."
                        class="oe_link pt-0"
                        colspan="2"
                    />
                </t>
            </xpath>
        </field>
    </record>
    <record id="action_compute_allergens_bom_template" model="ir.actions.server">
        <field name="name">Compute allergens from BoM</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            records.button_bom_allergens()
        </field>
    </record>
    <record id="action_compute_allergens_bom_product" model="ir.actions.server">
        <field name="name">Compute allergens from BoM</field>
        <field name="model_id" ref="product.model_product_product" />
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            records.button_bom_allergens()
        </field>
    </record>
</odoo>
