<odoo>

    <record id="wizard_mass_mrp_production_order" model="ir.ui.view">
        <field name="name">Mass MRP Production Order</field>
        <field name="model">mrp.mass.production.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Create MRP Prodcution Orders">
                <group>
                    <field name="picking_type_id" />
                    <field name="location_src_id" groups="stock.group_stock_manager" />
                    <field name="location_dest_id" groups="stock.group_stock_manager" />
                    <field name="produce_all" />
                    <field name="with_bom" />
                    <field
                        name="tag_ids"
                        widget="many2many_tags"
                        options="{'color_field': 'color', 'no_create_edit': True}"
                    />
                </group>
                <notebook>
                    <page string="MRP Production Orders">
                        <field name="mrp_production_order_entries">

                            <tree editable="bottom">
                                <field
                                    name="product_id"
                                    context="{'default_detailed_type': 'product'}"
                                />
                                <field name="product_qty" />
                                <field name="product_uom_id" />
                                <field
                                    name="bom_id"
                                    attrs="{'required': [('parent.with_bom', '!=', False)], 'column_invisible': [('parent.with_bom', '!=', True)]}"
                                />
                                <field
                                    name="product_consumed_id"
                                    context="{'default_detailed_type': 'product'}"
                                    attrs="{'required': [('parent.with_bom', '!=', True)], 'column_invisible': [('parent.with_bom', '!=', False)]}"
                                />
                                <field
                                    name="quantity"
                                    attrs="{'column_invisible': [('parent.with_bom', '!=', False)]}"
                                />
                                <field
                                    name="mrp_production_order_entry_id"
                                    invisible="1"
                                />
                                <field name="product_uom_category_id" invisible="1" />
                                <field
                                    name="tag_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color', 'no_create_edit': True}"
                                    optional="hide"
                                />
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button
                        name="action_create"
                        type="object"
                        string="Create"
                        class="oe_highlight"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_mass_mrp_production_order_action" model="ir.actions.act_window">
        <field name="name">Massive MRP Production Orders</field>
        <field name="res_model">mrp.mass.production.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="wizard_mass_mrp_production_order_menu_action"
        action="wizard_mass_mrp_production_order_action"
        parent="mrp.menu_mrp_manufacturing"
    />
</odoo>
