<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view_check_bom_alignment" model="ir.ui.view">
        <field name="name">mrp.production.form.check.bom.alignment</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/field[@name='reservation_state']" position="before">
                <field name="bom_alignment_warning" invisible="1" />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not bom_alignment_warning"
                >
                    <field name="bom_alignment_warning" readonly="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
