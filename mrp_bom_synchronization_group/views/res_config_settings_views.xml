<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form - bom synchronization</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mrp_byproduct']" position="after">
                <setting
                    id="bom_synchronization_mode"
                    string="BoM Synchronization Group"
                    help="Default behaviour assigned to new BoM Synchronization Groups when their members have different components."
                >
                    <field name="bom_synchronization_mode" widget="radio" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
