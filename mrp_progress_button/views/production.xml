<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_progress_button_form_view" model="ir.ui.view">
        <field name="name">mrp.production.view.form.progress.button</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <button name="button_unplan" position="before">
                <button
                    name="action_start"
                    invisible="state != 'confirmed'"
                    type="object"
                    string="Mark As Started"
                    class="oe_highlight"
                    context="{'previous_state': state}"
                />
            </button>
            <button name="action_assign" position="after">
                <button
                    name="action_unstart"
                    invisible="state != 'progress' or qty_producing != 0"
                    type="object"
                    string="Unstart"
                />
            </button>
        </field>
    </record>
</odoo>
