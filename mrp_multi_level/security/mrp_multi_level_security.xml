        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_mrp_multi_level_run" model="res.groups">
        <field name="name">Run MRP Manually</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
