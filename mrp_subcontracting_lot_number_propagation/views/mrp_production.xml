<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_subcontracting_form_view" model="ir.ui.view">
        <field name="name">mrp.production.subcontracting.form.view.inherit</field>
        <field name="model">mrp.production</field>
        <field
            name="inherit_id"
            ref="mrp_subcontracting.mrp_production_subcontracting_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_producing_ids']" position="after">
                <field name="is_lot_number_propagated" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='lot_producing_ids']" position="attributes">
                <attribute
                    name="required"
                    add="not is_lot_number_propagated"
                    separator=" and "
                />
            </xpath>
        </field>
    </record>
</odoo>
