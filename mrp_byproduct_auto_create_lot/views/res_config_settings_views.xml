<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="mrp_byproduct" position="after">
                <setting
                    id="propagate_lot_to_byproduct"
                    company_dependent="1"
                    string="Propagate Lot to Byproducts"
                    help="When set to 'Yes', byproducts receive the same lot name as the main product."
                >
                    <field name="propagate_lot_to_byproduct" widget="radio" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
