<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.byproduct.auto.pick</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mrp_byproduct']" position="after">
                <setting
                    id="byproduct_auto_pick"
                    groups="mrp.group_mrp_byproducts"
                    help="Keep manually entered byproduct quantities on manufacturing orders instead of resetting them to the quantity to produce."
                >
                    <field name="byproduct_auto_pick" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
