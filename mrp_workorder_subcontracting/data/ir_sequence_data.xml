<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="seq_subcontracting_purchase" model="ir.sequence">
        <field name="name">Purchase Subcontracting Order</field>
        <field name="code">purchase.order.subcontract</field>
        <field name="use_date_range">True</field>
        <field name="prefix">SC/%(y)s/</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_picking_type_subcontracting_out" model="ir.sequence">
        <field name="name">Sequence Picking Subcontracting OUT</field>
        <field name="code">stock.picking</field>
        <field name="prefix">WH/SOUT/</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="seq_picking_type_subcontracting_in" model="ir.sequence">
        <field name="name">Sequence Picking Subcontracting IN</field>
        <field name="code">stock.picking</field>
        <field name="prefix">WH/SIN/</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>
</odoo>
