<odoo>
    <record id="mrp_routing_workcenter_tree_view_subcontracting" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.tree.subcontracting</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="subcontract_ok" optional="hide" />
                <field name="subcontract_product_id" optional="hide" />
                <field
                    name="subcontractor_partner_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <record id="mrp_routing_workcenter_bom_tree_view_subcontracting" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.bom.tree.subcontracting</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_bom_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field name="subcontract_ok" optional="hide" />
                <field name="subcontract_product_id" optional="hide" />
                <field
                    name="subcontractor_partner_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_subcontracting" model="ir.ui.view">
        <field name="name">purchase.order.form.subcontracting</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="is_subcontracting" invisible="1" />
                <field name="mrp_subcontracting" invisible="1" />
                <field
                    name="subcontract_location_id"
                    invisible="not is_subcontracting"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list/field[@name='product_id']"
                position="after"
            >
                <field
                    name="workorder_id"
                    optional="hide"
                    column_invisible="not parent.mrp_subcontracting"
                />
                <field
                    name="production_id"
                    optional="hide"
                    column_invisible="not parent.mrp_subcontracting"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="after"
            >
                <field name="workorder_id" invisible="not parent.mrp_subcontracting" />
                <field name="production_id" invisible="not parent.mrp_subcontracting" />
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_form_view_subcontracting" model="ir.ui.view">
        <field name="name">purchase.order.line.form.subcontracting</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="workorder_id" />
                <field name="production_id" />
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_search_view_subcontracting" model="ir.ui.view">
        <field name="name">purchase.order.line.search.subcontracting</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="workorder_id" />
                <field name="production_id" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter
                    name="group_by_workorder_id"
                    string="Work Order"
                    domain="[]"
                    context="{'group_by': 'workorder_id'}"
                />
                <filter
                    name="group_by_production_id"
                    string="Manufacturing Order"
                    domain="[]"
                    context="{'group_by': 'production_id'}"
                />
            </xpath>
        </field>
    </record>

    <record id="purchase_order_type_search_view_subcontracting" model="ir.ui.view">
        <field name="name">purchase.order.type.search.subcontracting</field>
        <field name="model">purchase.order.type</field>
        <field
            name="inherit_id"
            ref="purchase_order_type.view_purchase_order_type_search"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_id']" position="after">
                <field name="is_subcontracting" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter
                    name="group_by_is_subcontracting"
                    string="Subcontracting"
                    domain="[]"
                    context="{'group_by': 'is_subcontracting'}"
                />
            </xpath>
        </field>
    </record>

    <record id="stock_warehouse_form_view_subcontracting" model="ir.ui.view">
        <field name="name">stock.warehouse.form.subcontracting</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='out_type_id']" position="after">
                <field name="sub_out_picking_type_id" />
                <field name="sub_in_picking_type_id" />
            </xpath>
        </field>
    </record>
</odoo>
