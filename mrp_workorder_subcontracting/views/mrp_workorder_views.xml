<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_workorder_view_form_subcontracting" model="ir.ui.view">
        <field name="name">mrp_workorder-form_inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="button_create_subcontract_order"
                    type="object"
                    string="Create Subcontract Order"
                    invisible="has_subcontract_documents"
                    groups="mrp.group_mrp_manager"
                    class="btn-primary"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_subcontract_purchase_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="not purchase_order_line_ids"
                >
                    Subcontract POs
                </button>
                <button
                    name="action_view_subcontract_transfers"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="not delivery_move_ids or not return_move_ids"
                >
                    Subcontract Movements
                </button>
            </xpath>
            <xpath expr="//page[@name='components']" position="after">
                <page
                    string="Parts to Send"
                    name="subcontract_components"
                    invisible="not subcontract_ok or subcontracting_flow != 'parts'"
                >
                    <field name="sub_component_move_ids" readonly="1">
                        <list>
                            <field name="product_id" readonly="state == 'done'" />
                            <field name="product_qty" string="To Send" />
                            <field name="picked" string="Consumed" />
                        </list>
                    </field>
                </page>
                <page string="Subcontract" name="subcontract">
                    <field name="has_subcontract_documents" invisible="1" />
                    <group>
                        <group>
                            <field
                                name="subcontract_ok"
                                groups="mrp.group_mrp_manager"
                                invisible="has_subcontract_documents"
                            />
                            <field
                                name="subcontract_product_id"
                                readonly="has_subcontract_documents"
                            />
                            <field
                                name="subcontract_partner_ids"
                                widget="many2many_tags"
                                readonly="has_subcontract_documents"
                            />
                        </group>
                        <group>
                            <field
                                name="subcontracting_flow"
                                widget="badge"
                                readonly="1"
                                invisible="not has_subcontract_documents"
                            />
                            <field
                                name="subcontract_flow_type"
                                widget="badge"
                                readonly="1"
                                decoration-warning="subcontract_flow_type == 'urgent'"
                                decoration-info="subcontract_flow_type == 'subcontractor_stock'"
                                invisible="not has_subcontract_documents"
                            />
                            <field
                                name="subcontract_state"
                                readonly="1"
                                widget="badge"
                                decoration-muted="subcontract_state == 'none'"
                                decoration-info="subcontract_state in ('bidding', 'rfq')"
                                decoration-primary="subcontract_state == 'confirmed'"
                                decoration-warning="subcontract_state == 'logistics'"
                                decoration-success="subcontract_state == 'done'"
                                decoration-danger="subcontract_state == 'exception'"
                                invisible="not has_subcontract_documents"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page
                            string="Purchase Lines"
                            name="subcontract_purchase_lines"
                            invisible="not has_subcontract_documents"
                        >
                            <field
                                name="purchase_order_line_ids"
                                nolabel="1"
                                readonly="1"
                            >
                                <list no_open="1">
                                    <field name="order_id" />
                                    <field name="partner_id" />
                                    <field name="product_id" optional="hide" />
                                    <field name="product_qty" optional="show" />
                                    <field
                                        name="date_planned"
                                        optional="show"
                                        widget="datetime"
                                        options="{'show_time': false}"
                                    />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'purchase' or state == 'done'"
                                        decoration-warning="state == 'to approve'"
                                        decoration-info="state == 'draft' or state == 'sent'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Delivery Moves"
                            name="subcontract_delivery_moves"
                            invisible="not has_subcontract_documents"
                        >
                            <field name="delivery_move_ids" nolabel="1" readonly="1">
                                <list no_open="1">
                                    <field name="picking_id" />
                                    <field name="sub_production_id" optional="hide" />
                                    <field name="partner_id" />
                                    <field name="product_id" />
                                    <field name="product_uom_qty" />
                                    <field name="quantity" />
                                    <field
                                        name="date_deadline"
                                        widget="datetime"
                                        options="{'show_time': false}"
                                        optional="show"
                                    />
                                    <field name="location_id" optional="hide" />
                                    <field name="location_dest_id" optional="show" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-danger="state=='cancel'"
                                        decoration-info="state== 'assigned'"
                                        decoration-muted="state == 'draft'"
                                        decoration-success="state == 'done'"
                                        decoration-warning="state not in ('draft','cancel','done','assigned')"
                                    />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Return Moves"
                            name="subcontract_return_moves"
                            invisible="not has_subcontract_documents"
                        >
                            <field name="return_move_ids" nolabel="1" readonly="1">
                                <list no_open="1">
                                    <field name="picking_id" />
                                    <field name="sub_production_id" optional="hide" />
                                    <field name="partner_id" />
                                    <field name="product_id" />
                                    <field name="product_uom_qty" />
                                    <field name="quantity" />
                                    <field
                                        name="date_deadline"
                                        widget="datetime"
                                        options="{'show_time': false}"
                                        optional="show"
                                    />
                                    <field name="location_id" optional="show" />
                                    <field name="location_dest_id" optional="hide" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-danger="state=='cancel'"
                                        decoration-info="state== 'assigned'"
                                        decoration-muted="state == 'draft'"
                                        decoration-success="state == 'done'"
                                        decoration-warning="state not in ('draft','cancel','done','assigned')"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
            <xpath expr="//page[@name='components']" position="attributes">
                <attribute
                    name="invisible"
                >subcontract_ok and subcontracting_flow == 'parts'</attribute>
            </xpath>
        </field>
    </record>

    <record id="mrp_workorder_view_tree_subcontracting_documents" model="ir.ui.view">
        <field name="name">mrp.workorder.tree.subcontracting.documents</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <list>
                <field name="production_id" />
                <field name="product_id" />
                <field name="name" />
                <field name="workcenter_id" />
                <field name="qty_remaining" />
                <field
                    name="subcontract_state"
                    widget="badge"
                    decoration-muted="subcontract_state == 'none'"
                    decoration-info="subcontract_state in ('bidding', 'rfq')"
                    decoration-primary="subcontract_state == 'confirmed'"
                    decoration-warning="subcontract_state == 'logistics'"
                    decoration-success="subcontract_state == 'done'"
                    decoration-danger="subcontract_state == 'exception'"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state in ('pending', 'waiting')"
                    decoration-info="state == 'ready'"
                    decoration-warning="state == 'progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'"
                />
            </list>
        </field>
    </record>
</odoo>
