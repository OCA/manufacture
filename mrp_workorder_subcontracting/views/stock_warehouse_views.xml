<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_warehouse_view_form_subcontracting" model="ir.ui.view">
        <field name="name">stock.warehouse.form.subcontracting</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='out_type_id']" position="after">
                <field name="sub_out_picking_type_id" />
                <field name="sub_in_picking_type_id" />
                <field name="sub_out_virtual_picking_type_id" />
                <field name="sub_in_virtual_picking_type_id" />
            </xpath>
        </field>
    </record>
</odoo>
