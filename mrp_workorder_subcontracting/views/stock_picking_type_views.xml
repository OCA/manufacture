<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_picking_type_view_form_subcontracting" model="ir.ui.view">
        <field name="name">stock.picking.type.form.subcontracting</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']/group[2]" position="inside">
                <field name="is_subcontract" />
            </xpath>
        </field>
    </record>
</odoo>
