<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="vpicktree_resupply_status" model="ir.ui.view">
        <field name="name">stock.picking.tree.resupply.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="resupply_status"
                    invisible="subcontracting_resupply_picking_count == 0"
                    optional="show"
                    groups="stock.group_stock_user"
                />
                <field name="subcontracting_resupply_picking_count" invisible="1" />
            </field>
        </field>
    </record>
    <record id="view_picking_form_resupply_status" model="ir.ui.view">
        <field name="name">stock.picking.form.resupply.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <group name="other_infos" position="inside">
                <field
                    name="resupply_status"
                    invisible="subcontracting_resupply_picking_count == 0"
                    groups="stock.group_stock_user"
                />
                <field name="subcontracting_resupply_picking_count" invisible="1" />
            </group>
        </field>
    </record>
</odoo>
